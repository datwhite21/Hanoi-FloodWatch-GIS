# ==============================================================================
# HANOI FLOODWATCH GIS - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Lưu ý: Sao chép file này thành .env trong thư mục backend/ và frontend/ tương ứng.
# TUYỆT ĐỐI KHÔNG commit file .env thật chứa thông tin mật lên Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH CHO BACKEND (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# URL của Frontend để cấu hình CORS bảo mật
CLIENT_URL=http://localhost:5173

# Kết nối CSDL PostgreSQL / PostGIS trên Supabase
# Lấy từ Supabase Dashboard: Project Settings -> Database -> Connection string (URI)
# Lưu ý: Sử dụng Connection Pooler port 6543 cho chế độ transaction hoặc port 5432 cho direct
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API Credentials
# Lấy từ Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...[YOUR-SERVICE-ROLE-KEY-SECRET]

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH CHO FRONTEND (frontend/.env)
# ------------------------------------------------------------------------------
# URL API Backend (ở local dùng http://localhost:5000, production dùng URL Render)
VITE_API_URL=http://localhost:5000/api

# Supabase Public Keys (Dành cho Frontend xác thực Supabase Auth)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...[YOUR-ANON-KEY]
